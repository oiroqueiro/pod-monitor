# Identificación del proyecto
PROJECT_NAME=monitor # El nombre qu quieras darle al pod
NETWORK_NAME=monitor-network # Nombre de la red

# Monitoreo y exportadores
PORT_NODE_EXPORTER=9100
PORT_PODMAN_EXPORTER=9882

# Ruta al socket de Podman (aquí se puede usar la ruta real o symlink)
# Si usas un symlink, asegúrate de que la ruta sea accesible por el usuario.
PODMAN_SOCK=/run/user/1000/podman/podman.sock

# Configuración de Promtail / Loki
OCI_NETBIRD_IP= # IP de OCI Central
MONITOR_NODE_NAME= # Nombre del nodo monitor (ej. vps-prod, local-pc)
JOURNAL_PATH= # Ruta de journal (ej. /run/log/journal o /var/log/journal)
